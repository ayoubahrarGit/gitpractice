<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stockmanager.controller.StockController"
            style="-fx-background-color: #f4f6f8;">

    <!-- Top toolbar -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: #2c3e50; -fx-padding: 10 16 10 16;">
            <Label text="📦 Gestion de Stock"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" text="Utilisateur : —"
                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 13px;"/>
            <Button text="Déconnexion" onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- Center content -->
    <center>
        <SplitPane orientation="VERTICAL" dividerPositions="0.65">

            <!-- Products panel -->
            <VBox spacing="8" style="-fx-padding: 12;">
                <Label text="Stock des produits"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <!-- Search + action bar -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Rechercher par nom…"
                               prefWidth="260" onAction="#handleSearch"/>
                    <Button text="🔍 Rechercher" onAction="#handleSearch"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addButton"    text="➕ Ajouter"    onAction="#handleAdd"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
                    <Button fx:id="editButton"   text="✏️ Modifier"   onAction="#handleEdit"
                            style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand;"/>
                    <Button fx:id="deleteButton" text="🗑 Supprimer" onAction="#handleDelete"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
                </HBox>

                <!-- Product table -->
                <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId"    text="ID"         prefWidth="50"/>
                        <TableColumn fx:id="colName"  text="Nom"        prefWidth="220"/>
                        <TableColumn fx:id="colQty"   text="Quantité"   prefWidth="100"/>
                        <TableColumn fx:id="colPrice" text="Prix (MAD)" prefWidth="120"/>
                        <TableColumn fx:id="colDate"  text="Date ajout" prefWidth="130"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun produit dans le stock."/>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- Transactions panel -->
            <VBox spacing="8" style="-fx-padding: 12;">
                <Label text="Historique des mouvements"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTxDate"    text="Date / Heure"  prefWidth="180"/>
                        <TableColumn fx:id="colTxProduct" text="Produit"       prefWidth="200"/>
                        <TableColumn fx:id="colTxAction"  text="Action"        prefWidth="100"/>
                        <TableColumn fx:id="colTxQty"     text="Δ Quantité"    prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun mouvement enregistré."/>
                    </placeholder>
                </TableView>
            </VBox>
        </SplitPane>
    </center>

    <!-- Bottom status bar -->
    <bottom>
        <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 4 12 4 12;">
            <Label fx:id="statusLabel" text=""
                   style="-fx-text-fill: #27ae60; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>
