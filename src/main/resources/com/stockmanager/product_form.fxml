<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.stockmanager.controller.ProductFormController"
            prefWidth="400">

    <buttonTypes>
        <ButtonType fx:constant="OK"/>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>

    <content>
        <VBox spacing="14" style="-fx-padding: 16 8 8 8;">

            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="110" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="220"/>
                </columnConstraints>

                <Label text="Nom du produit :"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" promptText="ex: Engrais NPK"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Quantité :"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="quantityField" promptText="ex: 100"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Prix (MAD) :"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="priceField" promptText="ex: 25.50"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Date d'ajout :"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dateField"
                            GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"/>
        </VBox>
    </content>
</DialogPane>
